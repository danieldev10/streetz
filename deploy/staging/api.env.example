# Reference only: fill values in the NEW Railway staging API service.
# All credentials, database and Redis endpoints must belong to staging.
NODE_ENV=production
WEB_APP_URL=https://REPLACE-STAGING-WEB-DOMAIN
DATABASE_URL=REPLACE-STAGING-POSTGRES-CONNECTION
DIRECT_URL=REPLACE-STAGING-DIRECT-POSTGRES-CONNECTION
SUPABASE_CA_CERT_B64=REPLACE-WITH-STAGING-DATABASE-CA-CERT-BASE64
DB_POOL_MAX=5
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_MAX_LIFETIME_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=15000
REDIS_URL=REPLACE-STAGING-REDIS-CONNECTION
JWT_ACCESS_SECRET=REPLACE-NEW-RANDOM-STAGING-SECRET
JWT_REFRESH_SECRET=REPLACE-DIFFERENT-RANDOM-STAGING-SECRET
JOBS_ENCRYPTION_KEY=REPLACE-WITH-SAME-STAGING-BASE64-32-BYTE-KEY-AS-WORKER
GUEST_TICKET_SECRET=REPLACE-THIRD-RANDOM-STAGING-SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
PAYSTACK_SECRET_KEY=sk_test_REPLACE_WITH_TEST_KEY
S3_BUCKET=REPLACE-STAGING-MEDIA-BUCKET
S3_REGION=eu-west-1
S3_ACCESS_KEY_ID=REPLACE-STAGING-MEDIA-KEY
S3_SECRET_ACCESS_KEY=REPLACE-STAGING-MEDIA-SECRET
MEDIA_CDN_BASE_URL=https://REPLACE-STAGING-CLOUDFRONT-DOMAIN
# Bootstrap without face verification; switch to production's mode after setup.
# For synthetic-photo flow testing use prototype-pass with REQUIRED=true;
# this records real AWS failures while granting test access after completion.
FACE_VERIFICATION_MODE=off
FACE_VERIFICATION_REQUIRED=false
AWS_REKOGNITION_REGION=eu-west-1
AWS_VERIFICATION_BUCKET=REPLACE-STAGING-VERIFICATION-BUCKET
AWS_VERIFICATION_ACCESS_KEY_ID=REPLACE-STAGING-VERIFICATION-KEY
AWS_VERIFICATION_SECRET_ACCESS_KEY=REPLACE-STAGING-VERIFICATION-SECRET
AWS_VERIFICATION_PREFIX=face-liveness
SMTP_HOST=REPLACE-SANDBOX-SMTP-HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE-SANDBOX-SMTP-USER
SMTP_PASS=REPLACE-SANDBOX-SMTP-PASSWORD
SMTP_FROM=Crushclub Staging <REPLACE-VERIFIED-SANDBOX-SENDER>
SENTRY_DSN=REPLACE-STAGING-API-DSN
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.1
# PORT is supplied by Railway. Commit SHA is used for Sentry releases automatically.
