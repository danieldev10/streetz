# Reference only. Create a separate Railway service with root apps/api.
# Copy/reference ALL staging API configuration, including DATABASE_URL,
# SUPABASE_CA_CERT_B64, JWT/guest secrets, WEB_APP_URL, SMTP, Paystack,
# Redis/media/verification startup settings and SENTRY_DSN.
# The worker must never point at production from the staging environment.

# Set the SAME key on API and worker. Generate with openssl rand -base64 32.
JOBS_ENCRYPTION_KEY=REPLACE-WITH-SAME-STAGING-BASE64-32-BYTE-KEY
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
WORKER_POLL_MS=1000
WORKER_LEASE_MS=120000
DB_POOL_MAX=4
SENTRY_ENVIRONMENT=staging

# Railway supplies PORT. No worker volume is required; jobs persist in PostgreSQL.
# Build: npm run prisma:generate && npm run build
# Start after certificate preparation: npm run start:worker
# Healthcheck: /health/ready
